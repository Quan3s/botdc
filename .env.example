# ===== Discord bot =====
DISCORD_TOKEN=
# ID Discord của owner/admin, nhiều ID cách nhau dấu phẩy
ADMIN_DISCORD_ID=
# Đặt 1 để chỉ chạy web (không đăng nhập Discord) khi dev
DISABLE_BOT=

# ===== Supabase (bỏ trống -> dùng file JSON cục bộ ./data/local-db.json) =====
SUPABASE_URL=
SUPABASE_KEY=

# ===== Web =====
PORT=3000
# Domain công khai của web (dùng tạo link nhiệm vụ / link shop)
RENDER_DOMAIN=http://localhost:3000
# Đặt 1 khi chạy sau HTTPS để cookie có cờ Secure
COOKIE_SECURE=

# ===== Nhiệm vụ vượt link =====
LINK4M_API_KEY=
LAYMA_TOKEN=
# bbmkts: /dapi?token=...&longurl=...&format=text (259 xu/lần, 1 lần/ngày)
# Có thể dùng alias cũ VUOTNHANH_API_TOKEN nếu chưa đổi tên biến
BBMKTS_API_TOKEN=
# Webhook Discord để cập nhật BXH coin + thông báo trả thưởng tuần
LEADERBOARD_WEBHOOK_URL=

# ===== Nhiệm vụ /star =====
YTB_CHANNEL_URL=
STAR_CHANNEL_NAME=star

# ===== Proxy API (tuỳ chọn): Cloud Status + mua nhanh + mua UGPhone =====
# Cloudflare Worker (https://...) hoặc SOCKS5/WARP (socks5h://user:pass@host:1080).
# Render dùng Worker vì không cài được warp-cli.
MEOWS_API_PROXY=
# MEOWS_STATUS_PROXY=            # tên cũ, dùng khi chưa set MEOWS_API_PROXY
# MEOWS_PROXY_KEY=               # nếu Worker đặt secret PROXY_KEY

# ===== Mua cloud (Hanami) =====
HANAMI_TOKEN=
APIKEY=                          # API key Supabase get-key: Cloud Status tự lấy tài khoản VMOS
# Tùy chọn: override tay kho test, mỗi dòng "email|password" (hoặc JSON array).
# Để trống = Cloud Status tự gọi API get-key như Buy Device → VMOS.
# Có thể sửa trong Admin Hub → Kinh tế (lưu vào KV hanami_test_accounts).
HANAMI_TEST_ACCOUNTS=
# ===== VMOS Cloud Status: API chính chủ (KHÔNG dùng Hanami để lấy status) =====
# Lấy tại https://cloud.vmoscloud.com → Developer → API.
# Job nền fetch tồn kho mỗi 5 giây; user gọi status cũng tự fetch lại sau 5 giây.
# Gist vẫn được ghi mỗi 5 phút để lưu lịch sử/fallback khi API lỗi.
VMOS_ACCESS_KEY=
VMOS_SECRET_KEY=
# Đặt 1 chỉ khi muốn tắt job nền (dev/test); web/bot vẫn gọi API chính chủ trực tiếp.
DISABLE_CLOUD_STATUS_PROBE=

# ===== Reg VSPhone =====
VSPHONE_API_URL=
VSPHONE_API_KEY=                  # chỉ dùng cho mua nhanh ASYNCTAS, KHÔNG dùng cho Cloud Status

# ===== VSPhone Cloud Status: API chính chủ (KHÔNG dùng Hanami/Meows để lấy status) =====
# Lấy tại VSPhone → Developer → API. Để trống thì Cloud Status vẫn dùng nguồn Meows cũ.
# Job nền fetch tồn kho mỗi 5 giây. VSPhone dùng chữ ký V4 (header Authorization),
# khác VMOS (V2 X-Sign). Nhớ thêm IP Render vào "Danh sách trắng IP" nếu portal bật.
VSPHONE_ACCESS_KEY=
VSPHONE_SECRET_KEY=

# ===== GitHub Gist (lưu kho shop + script plugin) =====
# Token cần quyền `gist` (classic) hoặc Gists: Read and write (fine-grained)
GITHUB_TOKEN=

# ===== Đổi thẻ Card2K (REST v3) =====
# Chỉ key server; KHÔNG gửi xuống frontend. Webhook: https://asynctas.cc.cd/api/topup/callback
CARD2K_API_KEY=

# ===== Marketplace / ACOIN =====
# Tỷ giá mặc định: 1 ACOIN = 1000 coin. Admin đổi được trong Admin Hub → Kinh tế.
# Có thể đặt sẵn giá trị khác ở đây (lưu vào KV exchange_coin_per_acoin khi admin đổi).
EXCHANGE_COIN_PER_ACOIN=
# Thư mục lưu chat/order history khi KHÔNG có GITHUB_TOKEN (mặc định ./data)
# Gist dùng để lưu chat/order: KV gist_chat / gist_orders.
MARKETPLACE_DATA_DIR=
